# ── Admin ─────────────────────────────────────────────────────────────────────
# Secret code required to promote the first admin (or subsequent admins).
# Set a strong, private string. The first user to log in via the Admin portal
# with this code will be granted the admin role (bootstrap). Subsequent users
# also need this code. Leave blank to disable code-based promotion after bootstrap.
ADMIN_SIGNUP_CODE="Admin123"

# ── Razorpay ──────────────────────────────────────────────────────────────────
# Get your Key ID from https://dashboard.razorpay.com/app/keys
# Use rzp_test_... for test mode, rzp_live_... for production
VITE_RAZORPAY_KEY_ID="rzp_test_SvIfLHKU2MktX9"

# ── PayU ──────────────────────────────────────────────────────────────────────
# Get your keys from https://onboarding.payu.in (live) or use test keys below
